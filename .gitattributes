* text=auto eol=lf
*.{cmd,[cC][mM][dD]} text eol=crlf
*.{bat,[bB][aA][tT]} text eol=crlf
# Vendored brand marks must stay byte-for-byte as published (licence terms forbid modification).
daprdocs/assets/icons/*.svg -text
# Generated diagrams are compared byte-for-byte by --check, so a CRLF checkout on Windows must not alter them.
daprdocs/assets/diagrams/*.svg text eol=lf
# Rendered diagram pngs: the root rule above leaves binary detection to a heuristic, and a png that gets eol-normalised on checkout is a corrupt png.
daprdocs/static/diagrams/*.png binary
